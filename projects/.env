# Credenciales de DESARROLLO, versionadas a proposito (prueba tecnica). No usar en produccion.
# Cambiar NEO4J_PASSWORD o POSTGRES_* despues del primer arranque exige `docker compose down -v`.
# Si el volumen pg_data viene de una version con Flyway, tambien hace falta `down -v` (ADR-011).

POSTGRES_DB=rickmorty
POSTGRES_USER=rickmorty
POSTGRES_PASSWORD=rickmorty

# Neo4j 4.4 exige >= 8 caracteres y distinto de "neo4j".
NEO4J_PASSWORD=neo4jpass

# HMAC del token propio (ADR-005): >= 32 bytes. Generado con: openssl rand -hex 32
AUTH_TOKEN_SECRET=c061ce30dff5add6c6890dd85130e1faa51d9da66f2a4f44d6d8d1a341f9bb6c
AUTH_TOKEN_TTL_HOURS=24

# Administrador del sistema (ADR-012): unico usuario con rol ADMIN, necesario para POST /api/admin/sync.
# El backend lo crea al arrancar y, si se cambia aqui la password, la actualiza en el siguiente arranque
# (no hace falta `down -v`). Mismas reglas que el registro: usuario 3-64 [A-Za-z0-9._-], password >= 8.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# OpenAPI / Swagger UI del backend (ADR-009). Poner false en un entorno productivo.
SWAGGER_ENABLED=true

# Perfil de compose activo por defecto: postgres, neo4j, zookeeper y kafka llevan `profiles: [infra]`
# y backend depende de ellos. Sin esto habria que escribir `docker compose --profile infra up`.
COMPOSE_PROFILES=infra
